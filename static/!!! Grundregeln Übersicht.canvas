		{"id":"formel","type":"text","text":"**d20 + Attributsmod + Profizienzbonus + Boni  →  vs. DC  →  Erfolgsgrad**","x":-620,"y":-530,"width":720,"height":60,"color":"5"},
		{"id":"krit-erfolg","type":"text","text":"## ✅ Krit. Erfolg\n≥ DC + 10\noder nat. **20**","x":-620,"y":-440,"width":260,"height":120,"color":"4"},
